+  /** Relabel enemy slots so memory order matches list order (slot i holds
+   *  list[i]). Swap-removes and slot reuse scatter the dense list across
+   *  memory, making every per-enemy loop cache-unfriendly. The relabeling is
+   *  a bijection over ALL slots (live ones to 0..n-1, free ones after them
+   *  in free-stack order) applied to every structure that stores a slot —
+   *  per-enemy arrays, list, free stack, last grid, tower and projectile
+   *  targets — so the simulation computes exactly the same thing. */
+  S.compact = function () {
+    var n = this.eCount, list = this.eList, remap = this.eRemap;
+    for (let i = 0; i < n; i++) remap[list[i]] = i;
+    var next = n, free = this.eFree;
+    for (let k = this.eFreeTop - 1; k >= 0; k--) remap[free[k]] = next++;   // next popped -> n
+    for (let k = 0; k < this.eFreeTop; k++) free[k] = remap[free[k]];
+    for (let a = 0; a < this.ePerm.length; a++) {
+      const arr = this.ePerm[a], tmp = this.eScratch[arr.constructor.name];
+      for (let s = 0; s < EC; s++) tmp[remap[s]] = arr[s];
+      arr.set(tmp.subarray(0, EC));
+    }
+    for (let i = 0; i < n; i++) { list[i] = i; this.eListPos[i] = i; }
+    var items = this.gItems;
+    for (let k = 0, m = this.gStart[this.gN]; k < m; k++) items[k] = remap[items[k]];
+    var towers = this.towers;
+    for (let i = 0; i < towers.length; i++) { const t = towers[i]; if (t.target >= 0) t.target = remap[t.target]; }
+    for (let p = 0; p < this.pCount; p++) { const g = this.pTgt[p]; if (g >= 0) this.pTgt[p] = remap[g]; }
+  };
+
